# The entrypoint of the image fills in ${BACKEND_URL} and ${DNS_RESOLVER} from the environment at start-up.
#
# The page and the API share one origin, so the browser needs no CORS and a passkey is bound to this origin. The backend
# limits the requests itself, by address and by account. Behind another proxy, the address it sees is the one of that
# proxy, so the backend must list the proxy in its trusted proxies to read the real address.

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    # The name of the backend is looked up again every few seconds, so a backend that was recreated is found at its new
    # address.
    resolver ${DNS_RESOLVER} valid=5s ipv6=off;
    set $backend ${BACKEND_URL};

    # An add_header in a location replaces the inherited ones, so each location includes the security headers itself.
    location /assets/ {
        include /etc/nginx/security.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Only the versioned API goes to the backend. The request is passed on as it came, with its Origin header.
    location /v1/ {
        include /etc/nginx/proxy.inc;
        proxy_pass $backend;
    }

    location / {
        include /etc/nginx/security.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }
}
