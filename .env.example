# Copy to .env. `make stand-secrets` writes the two secrets below with random values; git ignores .env.
# LOCAL ONLY: the root token of the dev-mode Vault of the stand.
VAULT_DEV_ROOT_TOKEN_ID=
# The password of the backend's MySQL user.
MYSQL_PASSWORD=
# Optional. The origins the API serves, separated by commas. The default is http://localhost:3000,http://localhost:8080.
# ORIGINS=
# Optional. The address prefixes that may set X-Forwarded-For, separated by commas. The default is 172.16.0.0/12, the
# networks of Docker, so the backend sees the address of the browser that the page passes on. The service itself trusts
# no proxy when the setting is empty.
# TRUSTED_PROXIES=
# Optional. debug, info, warn or error. The default is info.
# LOG_LEVEL=
# The model and its digest are pinned in scripts/versions.env. Do not set them here.
